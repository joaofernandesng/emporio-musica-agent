# Required: your API key (keep it secret; never commit .env).
OPENAI_API_KEY=
# Chat model used by the agent.
OPENAI_MODEL=gpt-5.4-mini
# Optional: endpoint of an OpenAI-compatible provider. Leave empty for OpenAI.
OPENAI_BASE_URL=
# Optional: fixed "current time" (ISO 8601, Campo Grande time) for demos and tests.
# Leave empty to use the real clock.
EMPORIO_NOW=
# Optional: model prices in USD per 1M tokens, used only for cost estimates in
# `python -m emporio.evals` and `python -m emporio.demo`.
OPENAI_PRICE_INPUT_PER_1M=0.75
OPENAI_PRICE_OUTPUT_PER_1M=4.50
